---
import { getCollection } from 'astro:content';
import RegionCard from '@/components/cards/RegionCard';
import EmptyState from '@/components/ui/EmptyState';
import IndexLayout from '@/layouts/IndexLayout.astro';

const regionTypeOrder = {
  国家: 0,
  地区: 1,
} as const;

const getRegionTypeOrder = (regionType?: string) =>
  regionTypeOrder[regionType as keyof typeof regionTypeOrder] ?? 2;

const regions = (await getCollection('regions')).sort((a, b) => {
  const typeDiff = getRegionTypeOrder(a.data.regionType) - getRegionTypeOrder(b.data.regionType);

  if (typeDiff !== 0) {
    return typeDiff;
  }

  const orderDiff = (a.data.mainlineOrder ?? 999) - (b.data.mainlineOrder ?? 999);

  if (orderDiff !== 0) {
    return orderDiff;
  }

  return a.data.title.localeCompare(b.data.title, 'zh-CN');
});

const filters = [...new Set(regions.flatMap((entry) => entry.data.tags))];
---

<IndexLayout
  title="国家与地区"
  eyebrow="Regions"
  summary="整理泰拉大陆上的国家、移动城市与重要地域，帮助从地理和政治背景进入世界观。"
  searchPlaceholder="搜索国家、移动城市、地域标签..."
  filters={filters}
>
  {
    regions.length > 0 ? (
      <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {regions.map((entry) => (
          <RegionCard
            slug={entry.data.slug}
            title={entry.data.title}
            summary={entry.data.summary}
            tags={entry.data.tags}
            regionType={entry.data.regionType}
            cover={entry.data.cover}
          />
        ))}
      </section>
    ) : (
      <EmptyState title="暂无地区条目" description="地区集合还没有可展示内容，后续可在 src/content/regions 中添加 MDX 条目。" />
    )
  }
</IndexLayout>
