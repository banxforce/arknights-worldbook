---
import { Search } from 'lucide-react';
import AppShell from './AppShell.astro';
import BaseLayout from './BaseLayout.astro';
import { Badge } from '@/components/ui/Badge';

interface Props {
  title: string;
  summary?: string;
  eyebrow?: string;
  searchPlaceholder?: string;
  filters?: string[];
}

const {
  title,
  summary,
  eyebrow = 'Terra Index',
  searchPlaceholder = '在当前索引中搜索条目...',
  filters = [],
} = Astro.props;
---

<BaseLayout title={`${title} | 泰拉百科`} description={summary ?? '泰拉百科索引'}>
  <AppShell breadcrumbs={[{ label: title }]}>
    <section class="mb-6 overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
      <div class="relative p-6 sm:p-7">
        <div class="pointer-events-none absolute right-0 top-0 h-36 w-72 rounded-bl-full bg-blue-50/70"></div>
        <div class="relative z-10 grid gap-6 xl:grid-cols-[minmax(0,1fr)_420px] xl:items-end">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-blue-600">{eyebrow}</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-normal text-slate-950">{title}</h1>
            {
              summary && (
                <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600">{summary}</p>
              )
            }
            {
              filters.length > 0 && (
                <div class="mt-5 flex flex-wrap gap-2">
                  {filters.slice(0, 8).map((filter) => (
                    <Badge tone="blue">{filter}</Badge>
                  ))}
                </div>
              )
            }
          </div>

          <div class="relative">
            <Search
              aria-hidden="true"
              className="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-slate-400"
            />
            <input
              type="search"
              aria-label={`${title}搜索`}
              placeholder={searchPlaceholder}
              class="h-11 w-full rounded-xl border border-slate-200/90 bg-slate-50/70 pl-12 pr-4 text-sm text-slate-900 shadow-inner shadow-slate-100/70 transition placeholder:text-slate-400 focus:border-blue-300 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-100"
            />
          </div>
        </div>
      </div>
    </section>

    <slot />
  </AppShell>
</BaseLayout>
