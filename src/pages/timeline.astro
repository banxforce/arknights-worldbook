---
import { getCollection } from 'astro:content';
import AppShell from '@/layouts/AppShell.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Timeline from '@/components/timeline/Timeline';
import EmptyState from '@/components/ui/EmptyState';

const events = await getCollection('events');
const timelineEvents = events.map((entry) => {
  const dateLabel = entry.data.eventDate ?? entry.data.updatedAt;
  const parsedYear = Number.parseInt(dateLabel, 10);

  return {
    slug: entry.data.slug,
    title: entry.data.title,
    summary: entry.data.summary,
    dateLabel,
    displayDate: entry.data.displayDate,
    sortYear: entry.data.eventSort ?? (Number.isFinite(parsedYear) ? parsedYear : 999999),
    tags: entry.data.tags,
    href: `/events/${entry.data.slug}`,
    cover: entry.data.cover,
    era: entry.data.era,
    period: entry.data.period,
    eventType: entry.data.eventType,
    locationLabel: entry.data.locationLabel,
    involved: entry.data.involved,
    nature: entry.data.nature,
    significance: entry.data.significance,
    mapNote: entry.data.mapNote,
    sourceNote: entry.data.sourceNote,
  };
});

const preferredFilters = ['古代文明', '泰拉近代', '主线', '地区事件', '灾变史', '罗德岛相关'];
const allFilters = new Set(events.flatMap((entry) => [...entry.data.tags, entry.data.era].filter(Boolean) as string[]));
const filters = preferredFilters.filter((filter) => allFilters.has(filter));
---

<BaseLayout title="时间线 | 泰拉百科" description="按事件集合整理泰拉世界观历史轨迹。">
  <AppShell breadcrumbs={[{ label: '时间线' }]}>
    <section class="relative mb-4 overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
      <div
        class="absolute inset-0 opacity-80"
        style="background-image: linear-gradient(rgba(148, 163, 184, 0.12) 1px, transparent 1px), linear-gradient(90deg, rgba(148, 163, 184, 0.12) 1px, transparent 1px); background-size: 24px 24px;"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute right-0 top-0 h-full w-1/2 bg-[radial-gradient(circle_at_68%_42%,rgba(96,165,250,0.18),transparent_18rem)]"
        aria-hidden="true"
      >
      </div>
      <div class="absolute right-8 top-5 hidden h-24 w-[420px] border-t border-slate-300/80 lg:block" aria-hidden="true">
        <div class="absolute right-0 top-[-5px] size-2 rounded-full border border-slate-300 bg-white"></div>
        <div class="absolute left-1/2 top-11 h-px w-36 bg-slate-300/70"></div>
        <div class="absolute left-[56%] top-8 h-8 w-px bg-slate-300/70"></div>
      </div>
      <div class="relative flex min-h-[156px] items-center justify-between gap-6 p-6 sm:p-7">
        <div class="min-w-0">
          <p class="text-sm font-bold text-blue-600">TIMELINE</p>
          <h1 class="mt-3 text-3xl font-bold leading-tight text-slate-950 sm:text-4xl">时间线 · 历史轨迹</h1>
          <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600">
            按时代脉络浏览泰拉世界的关键事件，覆盖主线剧情、地区事件、文明遗产与政治演进。
          </p>
        </div>
        <div class="hidden min-w-[250px] text-xs leading-6 text-slate-400 xl:block">
          <div class="font-semibold text-slate-500">TERRA INFO SYSTEM</div>
          <div class="mt-2">DATA INDEX // TL-01</div>
          <div>UPDATED // 2026.05.12</div>
        </div>
      </div>
    </section>

    {
      timelineEvents.length > 0 ? (
        <Timeline events={timelineEvents} filters={filters} client:load />
      ) : (
        <EmptyState title="暂无时间线事件" description="事件集合还没有可用于时间线展示的内容。" />
      )
    }
  </AppShell>
</BaseLayout>
