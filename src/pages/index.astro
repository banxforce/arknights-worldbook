---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppShell from '@/layouts/AppShell.astro';
import FactionBrowseCard from '@/components/home/FactionBrowseCard';
import FeaturedEntryCard from '@/components/home/FeaturedEntryCard';
import HeroOverviewCard from '@/components/home/HeroOverviewCard';
import KnowledgeGraphPreview from '@/components/home/KnowledgeGraphPreview';
import RegionCarousel from '@/components/home/RegionCarousel';
import TimelinePreview from '@/components/home/TimelinePreview';

const [regions, factions, events, terms] = await Promise.all([
  getCollection('regions'),
  getCollection('factions'),
  getCollection('events'),
  getCollection('terms'),
]);

const regionTypeOrder = {
  国家: 0,
  地区: 1,
} as const;

const getRegionTypeOrder = (regionType?: string) =>
  regionTypeOrder[regionType as keyof typeof regionTypeOrder] ?? 2;

const regionCards = regions
  .sort((a, b) => {
    const typeDiff = getRegionTypeOrder(a.data.regionType) - getRegionTypeOrder(b.data.regionType);

    if (typeDiff !== 0) {
      return typeDiff;
    }

    const orderDiff = (a.data.mainlineOrder ?? 999) - (b.data.mainlineOrder ?? 999);

    if (orderDiff !== 0) {
      return orderDiff;
    }

    return a.data.title.localeCompare(b.data.title, 'zh-CN');
  })
  .map((entry) => ({
  slug: entry.data.slug,
  title: entry.data.title,
  summary: entry.data.summary,
  tags: entry.data.tags,
}));

const factionCards = factions.map((entry) => ({
  slug: entry.data.slug,
  title: entry.data.title,
  summary: entry.data.summary,
  tags: entry.data.tags,
  cover: entry.data.cover,
}));

const eventCards = events.map((entry) => ({
  slug: entry.data.slug,
  title: entry.data.title,
  summary: entry.data.summary,
  eventDate: entry.data.eventDate,
}));

const originiumEntry = terms.find((entry) => entry.data.slug === 'originium') ?? terms[0];

if (!originiumEntry) {
  throw new Error('Phase 3 homepage requires at least one term entry.');
}

const featuredEntry = {
  slug: originiumEntry.data.slug,
  title: originiumEntry.data.title,
  aliases: originiumEntry.data.aliases,
  summary: originiumEntry.data.summary,
  tags: originiumEntry.data.tags,
  spoilerLevel: originiumEntry.data.spoilerLevel,
  cover: originiumEntry.data.cover,
};
---

<BaseLayout title="泰拉百科 | 明日方舟世界观知识库">
  <AppShell>
    <div class="grid gap-4 xl:grid-cols-2">
      <HeroOverviewCard />
      <KnowledgeGraphPreview />
      <TimelinePreview events={eventCards} />
      <RegionCarousel regions={regionCards} />
      <FeaturedEntryCard entry={featuredEntry} />
      <FactionBrowseCard factions={factionCards} />
    </div>
  </AppShell>
</BaseLayout>
