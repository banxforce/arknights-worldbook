---
import { getCollection, type CollectionEntry } from 'astro:content';
import KnowledgeGraph from '@/components/graph/KnowledgeGraph';
import AppShell from '@/layouts/AppShell.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  entryCollectionLabels,
  getEntryHref,
  type EntryCollection,
} from '@/lib/entry';

type AnyEntry =
  | CollectionEntry<'regions'>
  | CollectionEntry<'factions'>
  | CollectionEntry<'events'>
  | CollectionEntry<'terms'>
  | CollectionEntry<'sources'>;

const collections = [
  ['regions', await getCollection('regions')],
  ['factions', await getCollection('factions')],
  ['events', await getCollection('events')],
  ['terms', await getCollection('terms')],
  ['sources', await getCollection('sources')],
] as const;

const nodes = collections.flatMap(([collection, entries]) =>
  entries.map((entry) => ({
    id: `${collection}:${entry.data.slug}`,
    slug: entry.data.slug,
    title: entry.data.title,
    href: getEntryHref(collection, entry.data.slug),
    collection,
    collectionLabel: entryCollectionLabels[collection],
    summary: entry.data.summary,
  })),
);

const nodeIdBySlug = new Map(nodes.map((node) => [node.slug, node.id]));
const edgeIds = new Set<string>();
const edges = collections.flatMap(([collection, entries]) =>
  (entries as AnyEntry[]).flatMap((entry) => {
    const source = `${collection}:${entry.data.slug}`;
    const relatedSlugs = Object.values(entry.data.related ?? {}).flat();

    return relatedSlugs
      .map((targetSlug) => {
        const target = nodeIdBySlug.get(targetSlug);

        if (!target || target === source) {
          return null;
        }

        const id = `${source}->${target}`;

        if (edgeIds.has(id)) {
          return null;
        }

        edgeIds.add(id);
        return { id, source, target };
      })
      .filter((edge): edge is { id: string; source: string; target: string } => Boolean(edge));
  }),
);
---

<BaseLayout title="知识图谱 | 泰拉百科" description="基于条目 related 字段生成的泰拉百科关系网络。">
  <AppShell breadcrumbs={[{ label: '知识图谱' }]}>
    <section class="mb-6 overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-blue-600">Knowledge Graph</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-normal text-slate-950">知识图谱 · 关系网络</h1>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600">
        基于条目的 slug 关系字段生成节点和边，帮助快速理解地区、阵营、事件、术语与资料来源之间的关联。
      </p>
    </section>

    <KnowledgeGraph nodes={nodes} edges={edges} />
  </AppShell>
</BaseLayout>
