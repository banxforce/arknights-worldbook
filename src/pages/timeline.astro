---
import { getCollection } from 'astro:content';
import AppShell from '@/layouts/AppShell.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Timeline from '@/components/timeline/Timeline';
import EmptyState from '@/components/ui/EmptyState';

const events = await getCollection('events');
const timelineEvents = events.map((entry) => {
  const dateLabel = entry.data.eventDate ?? entry.data.updatedAt;
  const parsedYear = Number.parseInt(dateLabel, 10);

  return {
    slug: entry.data.slug,
    title: entry.data.title,
    summary: entry.data.summary,
    dateLabel,
    sortYear: Number.isFinite(parsedYear) ? parsedYear : 999999,
    tags: entry.data.tags,
    href: `/events/${entry.data.slug}`,
  };
});

const filters = [...new Set(events.flatMap((entry) => entry.data.tags))];
---

<BaseLayout title="时间线 | 泰拉百科" description="按事件集合整理泰拉世界观历史轨迹。">
  <AppShell breadcrumbs={[{ label: '时间线' }]}>
    <section class="mb-6 overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-blue-600">Timeline</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-normal text-slate-950">时间线 · 历史轨迹</h1>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600">
        基于事件集合整理泰拉世界观中的关键节点，第一版先提供年份排序和基础标签筛选。
      </p>
    </section>

    {
      timelineEvents.length > 0 ? (
        <Timeline events={timelineEvents} filters={filters} client:load />
      ) : (
        <EmptyState title="暂无时间线事件" description="事件集合还没有可用于时间线展示的内容。" />
      )
    }
  </AppShell>
</BaseLayout>
