---
import AppShell from '@/layouts/AppShell.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PagefindSearch from '@/components/search/PagefindSearch';

const query = Astro.url.searchParams.get('q') ?? '';
---

<BaseLayout title="搜索 | 泰拉百科" description="搜索泰拉百科中的地区、组织、事件、术语和档案。">
  <AppShell breadcrumbs={[{ label: '搜索' }]}>
    <section class="mb-6 rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-blue-600">Search</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-normal text-slate-950">搜索</h1>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600">
        使用 Pagefind 在已构建的静态内容中检索条目标题、正文摘要和页面 URL。
      </p>
    </section>

    <PagefindSearch initialQuery={query} client:load />
  </AppShell>
</BaseLayout>
