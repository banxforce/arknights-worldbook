---
import { getCollection } from 'astro:content';
import FactionCard from '@/components/cards/FactionCard';
import EmptyState from '@/components/ui/EmptyState';
import IndexLayout from '@/layouts/IndexLayout.astro';

const factions = (await getCollection('factions')).sort((a, b) => {
  const orderA = a.data.mainlineOrder ?? Number.POSITIVE_INFINITY;
  const orderB = b.data.mainlineOrder ?? Number.POSITIVE_INFINITY;

  return orderA - orderB || a.data.title.localeCompare(b.data.title, 'zh-CN');
});

const filters = [...new Set(factions.flatMap((entry) => entry.data.tags))];
---

<IndexLayout
  title="阵营组织"
  eyebrow="Factions"
  summary="汇总罗德岛、整合运动等组织条目，呈现它们与地区、事件和核心术语之间的关系。"
  searchPlaceholder="搜索组织、立场、行动领域..."
  filters={filters}
>
  {
    factions.length > 0 ? (
      <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {factions.map((entry) => (
          <FactionCard
            slug={entry.data.slug}
            title={entry.data.title}
            summary={entry.data.summary}
            tags={entry.data.tags}
            factionType={entry.data.factionType}
            cover={entry.data.cover}
          />
        ))}
      </section>
    ) : (
      <EmptyState title="暂无阵营条目" description="阵营集合还没有可展示内容，后续可在 src/content/factions 中添加 MDX 条目。" />
    )
  }
</IndexLayout>
